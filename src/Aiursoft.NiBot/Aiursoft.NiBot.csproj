<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <Version>10.0.33</Version>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>nibot</AssemblyName>
    <RootNamespace>Aiursoft.NiBot</RootNamespace>
    <IsTestProject>false</IsTestProject>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
    <IsPackable>true</IsPackable>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>nibot</ToolCommandName>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <SelfContained>false</SelfContained>
    <PublishTrimmed>false</PublishTrimmed>
    <PublishReadyToRun>false</PublishReadyToRun>
    <PublishSingleFile>false</PublishSingleFile>
    <Company>Aiursoft</Company>
    <Product>NiBot</Product>
    <Authors>edgeneko anduin2017</Authors>
    <Description>A cli tool helps you to de-duplicate images in a folder.</Description>
    <PackageId>Aiursoft.NiBot</PackageId>
    <PackageTags>cli nuget dotnet tool image deduplication</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/AiursoftWeb/nibot</PackageProjectUrl>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/AiursoftWeb/nibot</RepositoryUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="." />
    <None Include="../../LICENSE" Pack="true" PackagePath="." />
    <None Include="../../THIRD-PARTY-NOTICES" Pack="true" PackagePath="." />
    <ProjectReference Include="..\Aiursoft.NiBot.Dedup\Aiursoft.NiBot.Dedup.csproj" />
  </ItemGroup>
  <Target Name="ExcludeToolDevelopmentAssets" AfterTargets="ComputeFilesToPublish">
    <ItemGroup>
      <!-- Keep runtime binaries; symbols, link libraries, and mobile SDK archives are not used by this CLI. -->
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)"
        Condition="'%(ResolvedFileToPublish.Extension)' == '.pdb'
          Or '%(ResolvedFileToPublish.Extension)' == '.lib'
          Or '%(ResolvedFileToPublish.Extension)' == '.aar'
          Or '%(ResolvedFileToPublish.Filename)%(ResolvedFileToPublish.Extension)' == 'onnxruntime.xcframework.zip'" />
    </ItemGroup>
  </Target>
</Project>
